{
  "name": "wtf.js",
  "version": "0.0.1",
  "description": "slightly unusual javascript experiments, with a wink.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./compiler": {
      "types": "./types/compiler.d.ts",
      "default": "./src/compiler/index.js"
    },
    "./vite": {
      "types": "./types/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./presets/*": {
      "types": "./types/presets.d.ts",
      "default": "./src/lsd/presets/*.js"
    }
  },
  "files": [
    "src",
    "types"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "magic-string": "^1.4.3"
  },
  "devDependencies": {
    "lodash-es": "^4.18.1",
    "ramda": "^0.32.0"
  }
}
